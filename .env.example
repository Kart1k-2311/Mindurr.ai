# Supabase (copy actual values from the project's Supabase dashboard into .env)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only used as a fallback verification path (Supabase now signs access tokens
# with ES256 via JWKS, so this can stay a placeholder).
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Google Gemini API key for AI analysis / matching endpoints
AI_API_KEY=your-gemini-api-key